# Google AI Studio API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash, etc.)
